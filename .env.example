# Database Configuration
# SQLite is used by default for zero RAM overhead in local development
DATABASE_URL=sqlite:///./cloudvault.db

# Celery Configuration
# Set to True to run background tasks synchronously in-process (no Redis needed!)
CELERY_TASK_ALWAYS_EAGER=True
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
# Set to True to store files in local directory-based simulations
MOCK_STORAGE=True
MOCK_STORAGE_DIR=./storage/mock

# JWT Authentication
JWT_SECRET_KEY=super_secret_jwt_key_change_me_in_production_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MinIO Configuration (Hot Storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=cloudvault_admin
MINIO_ROOT_PASSWORD=minio_secure_password_123
MINIO_BUCKET_NAME=cloudvault-hot

# SeaweedFS Configuration (Warm Storage)
SEAWEEDFS_FILER_URL=http://localhost:8333
SEAWEEDFS_BUCKET_NAME=cloudvault-warm

# Scality S3 Server Configuration (Archive Storage)
SCALITY_ENDPOINT=http://localhost:18000
SCALITY_ACCESS_KEY_ID=scality_admin
SCALITY_SECRET_ACCESS_KEY=scality_secret_key_123
SCALITY_BUCKET_NAME=cloudvault-archive

# Backend Config
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Config
VITE_API_URL=http://localhost:8000/api/v1
